---
// src/pages/index.astro
const recursos = [
  {
    titulo: "Cheat Sheet: Spring Boot",
    categoria: "Desarrollo",
    descripcion: "Anotaciones esenciales para crear APIs REST en Java.",
    enlace: "#"
  },
  {
    titulo: "Plantilla de Presupuesto",
    categoria: "Finanzas",
    descripcion: "Excel automatizado para controlar gastos universitarios.",
    enlace: "#"
  },
  {
    titulo: "Esquemas SQL - E-commerce",
    categoria: "Bases de Datos",
    descripcion: "Estructura relacional lista para tu próximo proyecto backend.",
    enlace: "#"
  }
];
---
<html lang="es">
  <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Kev | Digital - Recursos Gratuitos para Tech</title>
  
  <!-- SEO Básico -->
  <meta name="description" content="Apuntes, código, esquemas SQL y plantillas gratuitas para estudiantes de computación y desarrolladores backend. Descarga directa." />
  <meta name="keywords" content="recursos programación, plantillas excel estudiantes, esquemas sql, spring boot peru, kev digital, apuntes backend" />
  <meta name="author" content="Kev" />

  <!-- Open Graph / Redes Sociales -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kev-digital-web.vercel.app/" />
  <meta property="og:title" content="Kev | Digital - Apuntes y Código" />
  <meta property="og:description" content="Recursos, plantillas y código para sobrevivir en tech. Totalmente gratis." />
  <!-- TODO: Sube una imagen de portada (1200x630px) a tu carpeta public y cambia este enlace -->
  <meta property="og:image" content="https://kev-digital-web.vercel.app/portada-seo.jpg" />

  <!-- Tipografía -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
</head>
  
  <style is:global>
    @import "tailwindcss";
  </style>

  <body class="bg-yellow-400 font-['Space_Grotesk'] text-black min-h-screen">
    
    <main class="max-w-5xl mx-auto p-6 mt-12 mb-20">
      
      <!-- Hero Section -->
      <header class="bg-white border-4 border-black shadow-[8px_8px_0px_rgba(0,0,0,1)] p-8 mb-12">
        <h1 class="text-5xl md:text-6xl font-bold mb-4 uppercase tracking-tight">Kev | Digital</h1>
        <p class="text-xl font-bold mb-6 text-gray-800">Apuntes, código y plantillas para sobrevivir en tech.</p>
        
        <a href="#recursos" class="inline-block bg-blue-500 text-white font-bold text-lg py-3 px-6 border-4 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
          Ver recursos gratuitos
        </a>
      </header>

      <!-- Barra de Filtros -->
      <nav class="flex flex-wrap gap-4 mb-8" id="filtros">
        <button data-filtro="todos" class="filtro-btn bg-black text-white font-bold py-2 px-4 border-2 border-black hover:bg-white hover:text-black transition-colors">Todos</button>
        <button data-filtro="Desarrollo" class="filtro-btn bg-white text-black font-bold py-2 px-4 border-2 border-black hover:bg-green-400 transition-colors">Desarrollo</button>
        <button data-filtro="Finanzas" class="filtro-btn bg-white text-black font-bold py-2 px-4 border-2 border-black hover:bg-green-400 transition-colors">Finanzas</button>
        <button data-filtro="Bases de Datos" class="filtro-btn bg-white text-black font-bold py-2 px-4 border-2 border-black hover:bg-green-400 transition-colors">Bases de Datos</button>
      </nav>

      <!-- Cuadrícula de Recursos -->
      <section id="recursos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {recursos.map((recurso) => (
          <article class="recurso-card bg-white border-4 border-black p-6 shadow-[6px_6px_0px_rgba(0,0,0,1)] hover:-translate-y-1 hover:-rotate-2 hover:shadow-[8px_8px_0px_rgba(0,0,0,1)] transition-all flex flex-col" data-categoria={recurso.categoria}>
            <span class="inline-block bg-green-400 border-2 border-black px-3 py-1 text-xs font-bold uppercase mb-4 self-start">
              {recurso.categoria}
            </span>
            <h3 class="text-2xl font-bold mb-3 leading-tight">{recurso.titulo}</h3>
            <p class="text-gray-800 font-medium mb-6 flex-grow">{recurso.descripcion}</p>
            
            <a href={recurso.enlace} target="_blank" class="block w-full text-center bg-black text-white font-bold text-lg py-3 border-2 border-black hover:bg-white hover:text-black transition-colors">
              Descargar
            </a>
          </article>
        ))}
      </section>

      <!-- Lead Magnet (Captación de Audiencia) -->
<section class="bg-blue-500 border-4 border-black p-8 shadow-[8px_8px_0px_rgba(0,0,0,1)] mb-16 flex flex-col md:flex-row gap-8 items-center justify-between">
  <div class="text-white max-w-2xl">
    <span class="inline-block bg-yellow-400 text-black border-2 border-black px-3 py-1 text-xs font-bold uppercase mb-4">
      Recurso Premium Gratuito
    </span>
    <h2 class="text-3xl md:text-4xl font-bold mb-4 uppercase leading-tight">La guía definitiva de Spring Boot para entrevistas</h2>
    <p class="text-lg font-medium">
      Déjame tu correo y te envío gratis el PDF con las preguntas, arquitecturas y anotaciones que me ayudaron a dominar el desarrollo backend.
    </p>
  </div>
  
  <form id="lead-magnet-form" action="https://formspree.io/f/xljbgpyy" method="POST" class="w-full md:w-auto flex flex-col sm:flex-row gap-4 relative">
  <!-- El input del correo (asegúrate de que tenga el name="email") -->
  <input 
    type="email" 
    name="email"
    placeholder="tu@correo.com" 
    required 
    class="p-4 border-4 border-black text-black font-bold text-lg focus:outline-none focus:bg-gray-100 w-full md:w-72"
  />
  
  <!-- El botón de envío -->
  <button 
    type="submit" 
    class="bg-yellow-400 text-black font-bold text-lg py-4 px-8 border-4 border-black hover:-translate-y-1 hover:-rotate-2 hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] transition-all">
    ¡Quiero la guía!
  </button>
  
  <!-- Mensaje de éxito oculto inicialmente -->
  <div id="form-success-msg" class="hidden absolute top-0 left-0 w-full h-full bg-blue-500 flex items-center justify-center border-4 border-black shadow-[6px_6px_0px_rgba(0,0,0,1)]">
    <p class="text-white font-bold text-xl text-center px-4">¡Listo! Revisa tu correo, la guía va en camino 🚀</p>
  </div>
</form>
</section>
      
      <!-- Sobre el Creador (Autenticidad) -->
      <section class="bg-white border-4 border-black p-8 shadow-[8px_8px_0px_rgba(0,0,0,1)] flex flex-col md:flex-row gap-8 items-center">
       <div class="w-32 h-32 bg-gray-200 border-4 border-black flex-shrink-0 overflow-hidden">
        <!--tu foto de perfil aqui -->
  <img src="/Foto 2.png" alt="Foto de Kev" class="w-full h-full object-cover" />
</div>
        <div>
          <h2 class="text-3xl font-bold mb-3 uppercase">Sobre mí</h2>
          <p class="text-lg font-medium text-gray-800 mb-4">
            Soy estudiante de Ingenieria de Software en Perú,  desarrollador backend (Java/Spring Boot) y creador de contenido. Construí este espacio para compartir el código, las plantillas y los apuntes que uso en mi día a día.
          </p>
          <a href="https://github.com/KevinJ0612" target="_blank" class="inline-block bg-white text-black font-bold py-2 px-4 border-2 border-black hover:bg-black hover:text-white transition-colors underline decoration-2 underline-offset-4">
            Ver mi GitHub
          </a>
        </div>
      </section>

    </main>

    <!-- Script para la lógica de filtrado -->
   <script>
  // --- Lógica de Filtros (ya la tenías) ---
  const botones = document.querySelectorAll('.filtro-btn');
  const tarjetas = document.querySelectorAll('.recurso-card');

  botones.forEach(boton => {
    boton.addEventListener('click', () => {
      const filtro = boton.getAttribute('data-filtro');
      
      tarjetas.forEach(tarjeta => {
        if (filtro === 'todos' || tarjeta.getAttribute('data-categoria') === filtro) {
          tarjeta.classList.remove('hidden');
          tarjeta.classList.add('flex');
        } else {
          tarjeta.classList.remove('flex');
          tarjeta.classList.add('hidden');
        }
      });
    });
  });

  // --- Lógica del Formulario Lead Magnet ---
      const form = document.getElementById('lead-magnet-form');
      const successMsg = document.getElementById('form-success-msg');

      if (form) {
        form.addEventListener('submit', async function(event) {
          event.preventDefault(); // Evita que la página recargue

          const formData = new FormData(form);
          const url = form.getAttribute('action');
          const submitButton = form.querySelector('button[type="submit"]');

          // Cambia el texto del botón mientras envía
          const originalText = submitButton.innerHTML;
          submitButton.innerHTML = "Abriendo guía..."; // Cambiamos el texto
          submitButton.disabled = true;

          try {
            const response = await fetch(url, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });

            if (response.ok) {
              // Mostramos el mensaje de éxito
              successMsg.classList.remove('hidden');
              form.reset(); // Limpia el campo
              
              // LA MAGIA: Esperamos 1 segundo y lo enviamos al PDF
              setTimeout(() => {
                  // Reemplaza esto con TU ENLACE REAL de Google Drive o donde esté tu PDF
                  window.location.href = "https://docs.google.com/document/d/TU_ENLACE_AQUI/edit?usp=sharing";
              }, 1500); // 1500 milisegundos = 1.5 segundos
              
            } else {
              alert("Hubo un problema al guardar tu correo. Intenta de nuevo.");
              submitButton.innerHTML = originalText;
              submitButton.disabled = false;
            }
          } catch (error) {
            alert("Error de conexión. Revisa tu internet e intenta de nuevo.");
            submitButton.innerHTML = originalText;
            submitButton.disabled = false;
          }
        });
      }
</script>
  </body>
</html>